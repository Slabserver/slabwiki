      "html": "<button class=\"ds-btn ds-btn-gold\">Season 4</button>",
      "css": ":host{--c-surface:#24201a;--c-surface-2:#1c1913;--c-card:#2f2a22;--c-fg:#f0ebe0;--c-body:#d8cfba;--c-muted:#c2b8a2;--c-line:#0c0a07;--c-grass:#4b7131;--c-grass-hi:#7cc24a;--c-gold:#e0a92e;--c-wood:#8a5e35;--c-card-sh:rgba(0,0,0,.5);--c-shadow:rgba(0,0,0,.6)}.ds-btn{font-family:'Silkscreen',ui-monospace,monospace;display:inline-flex;align-items:center;gap:8px;border:3px solid var(--c-line);padding:8px 12px;background:var(--c-surface-2);color:var(--c-fg);font-size:10px;line-height:1;text-transform:uppercase;letter-spacing:.03em;box-shadow:3px 3px 0 var(--c-card-sh);cursor:pointer;transition:filter .08s ease,transform .05s ease}.ds-btn:hover{filter:brightness(1.08)}.ds-btn:active{transform:translate(2px,2px);box-shadow:1px 1px 0 var(--c-card-sh)}.ds-btn:focus-visible{outline:3px solid var(--c-grass-hi);outline-offset:2px}.ds-btn-gold{background:var(--c-gold);color:#2a2620}"
