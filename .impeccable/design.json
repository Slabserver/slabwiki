    {
      "name": "Search Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Sunk search field; grass border on focus.",
      "html": "<input class=\"ds-input\" type=\"search\" placeholder=\"Search the wiki…\">",
      "css": ":host{--c-surface:#24201a;--c-surface-2:#1c1913;--c-card:#2f2a22;--c-fg:#f0ebe0;--c-body:#d8cfba;--c-muted:#c2b8a2;--c-line:#0c0a07;--c-grass:#4b7131;--c-grass-hi:#7cc24a;--c-gold:#e0a92e;--c-wood:#8a5e35;--c-card-sh:rgba(0,0,0,.5);--c-shadow:rgba(0,0,0,.6)}.ds-input{width:100%;font-size:15px;padding:8px 12px;background:var(--c-surface);border:3px solid var(--c-line);color:var(--c-fg);outline:none;box-shadow:inset 2px 2px 0 rgb(0 0 0/.12);font-family:'Nunito Sans',system-ui,sans-serif}.ds-input::placeholder{color:var(--c-muted)}.ds-input:focus{border-color:var(--c-grass-hi)}"
    },
    {
      "name": "Entry Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Clickable content card; lifts on hover with stepped motion.",
      "html": "<a class=\"ds-card\" href=\"#\"><span class=\"ds-card-t\">Spawn</span><span class=\"ds-card-d\">The Season 4 spawn build.</span></a>",
      "css": ":host{--c-surface:#24201a;--c-surface-2:#1c1913;--c-card:#2f2a22;--c-fg:#f0ebe0;--c-body:#d8cfba;--c-muted:#c2b8a2;--c-line:#0c0a07;--c-grass:#4b7131;--c-grass-hi:#7cc24a;--c-gold:#e0a92e;--c-wood:#8a5e35;--c-card-sh:rgba(0,0,0,.5);--c-shadow:rgba(0,0,0,.6)}.ds-card{display:flex;flex-direction:column;gap:4px;padding:14px;background:var(--c-card);border:3px solid var(--c-line);box-shadow:4px 4px 0 var(--c-card-sh);text-decoration:none;transition:transform .08s steps(2),box-shadow .08s steps(2),border-color .1s}.ds-card:hover,.ds-card:focus-visible{transform:translate(-3px,-3px);border-color:var(--c-grass);box-shadow:7px 7px 0 var(--c-card-sh);outline:none}.ds-card-t{font-family:'Silkscreen',ui-monospace,monospace;font-size:14px;color:var(--c-fg)}.ds-card-d{font-family:'Nunito Sans',system-ui,sans-serif;font-size:14px;color:var(--c-body)}"
    },
