      "description": "Pixel status badge; gold marks featured.",
      "html": "<span class=\"ds-badge\">New</span> <span class=\"ds-badge ds-badge-gold\">Featured</span>",
      "css": ":host{--c-surface:#24201a;--c-surface-2:#1c1913;--c-card:#2f2a22;--c-fg:#f0ebe0;--c-body:#d8cfba;--c-muted:#c2b8a2;--c-line:#0c0a07;--c-grass:#4b7131;--c-grass-hi:#7cc24a;--c-gold:#e0a92e;--c-wood:#8a5e35;--c-card-sh:rgba(0,0,0,.5);--c-shadow:rgba(0,0,0,.6)}.ds-badge{font-family:'Silkscreen',ui-monospace,monospace;display:inline-flex;align-items:center;border:2px solid var(--c-line);padding:4px 6px;font-size:8px;line-height:1;text-transform:uppercase;letter-spacing:.03em;background:var(--c-surface-2);color:var(--c-fg)}.ds-badge-gold{background:var(--c-gold);color:#2a2620}"
    },
    {
